# --- Copyrighted game material (you must supply your own legally-dumped copy) ---
# The input/ tree is the demo's own EBOOT + USRDIR assets; never committed.
input/
_extract/
*.zip
*.BIN
*.elf
*.SELF
*.self

# --- Generated recompiled code (105 MB; regenerate from your own ELF) ---
src/recomp/*.cpp
src/recomp/*.h
src/_recomp_prefold/
_recomp_backup_orig/
*.bak

# --- Analysis outputs: derived from YOUR ELF, regenerated by the pipeline
#     (ppu_loader.py / elf_symbols.py). Function and symbol tables carved out
#     of the demo's binary are not ours to redistribute. ---
meta/
# NOTE: src/gen/ (HLE NID table) IS committed — small, keeps the harness
# build-ready without re-running gen_hle_nids.py. src/compat/ likewise.

# --- Build output ---
build/
build_int/
out/
cmake-build-*/
*.map

# --- Logs / scratch ---
meta/_*.log
*.log
run_*.txt
stderr*.txt
stdout*.txt
*.tmp

# --- IDE / OS ---
.vs/
.vscode/
*.user
*.suo
.idea/
Thumbs.db
.DS_Store

# build helpers
build_game.exit
build_cfg.log

# Extracted SPU images (derived from your own ELF; regenerate via extract_spu_images.py)
spu/
run*.log

# Lifted SPU images (derived from your own ELF; regenerate via spu_lifter.py)
src/spu_gen/

spu_trace.txt

# --- Debug capture / scratch (frame dumps, texture dumps, shader dumps) ---
frames/
cubeon/
cuboff/
waterrun*/
waterlong/
*.png
*.bmp
*.hlsl
*.asm
fps*.txt
seq*.txt
!docs/images/*.png
