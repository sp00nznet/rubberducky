# --- Copyrighted game material (you must supply your own legally-dumped copy) ---
# The input/ tree is the demo's own EBOOT + USRDIR assets; never committed.
input/
_extract/
*.zip
*.BIN
*.elf
*.SELF
*.self

# --- Generated recompiled code (105 MB; regenerate from your own ELF) ---
src/recomp/*.cpp
src/recomp/*.h
# NOTE: src/gen/ (HLE NID table) IS committed — small, keeps the harness
# build-ready without re-running gen_hle_nids.py. src/compat/ likewise.

# --- Build output ---
build/
out/
cmake-build-*/
*.map

# --- Logs / scratch ---
meta/_*.log
*.log
run_*.txt
stderr*.txt
stdout*.txt
*.tmp

# --- IDE / OS ---
.vs/
.vscode/
*.user
*.suo
.idea/
Thumbs.db
.DS_Store

# build helpers
build_game.exit
build_cfg.log
